DATABASE_URL=
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=

# 32 random bytes as 64 hex characters, server-only. Keep stable across deployments.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Sender account only; never commit the App Password.
INVITATION_FROM=wharfmeetings@gmail.com
GMAIL_APP_PASSWORD=

# Single-workspace Slack demo. Keep all credentials server-only.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
ANTHROPIC_API_KEY=
SLACK_AGENT_MODEL=claude-haiku-5-5

# Jev-first Slack interpretation. All model keys are server-only.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
SLACK_INTERPRETER=jev

# Microsoft Entra app: work/school + personal Microsoft accounts.
# Web redirect: APP_URL/api/auth/microsoft/callback
# Delegated permissions: User.Read, Calendars.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Official Sign in with Apple (identity only, no iCloud calendar access).
# Services ID, Apple Developer Team ID, and Sign in with Apple key ID.
# Return URL: APP_URL/api/auth/apple/callback (registered HTTPS domain required).
# Private .p8 key stays server-only; escaped newlines are accepted.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Multi-workspace Slack OAuth. Enable only after migration and Slack app configuration.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_PUBLIC_INSTALL_ENABLED=false

# Discord uses the same scheduling agent and calendar workflow as Slack.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_TIMEZONE=America/Denver

# Marketing: migrate before enabling. Both switches are required for browser events.
MARKETING_ENABLED=false
NEXT_PUBLIC_MARKETING_ENABLED=false
# Verified sign-in emails, comma-separated; blank denies dashboard access.
MARKETING_ADMIN_EMAILS=
