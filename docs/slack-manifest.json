{
  "display_information": {
    "name": "Wharf",
    "description": "Find a shared meeting time and send calendar invitations.",
    "background_color": "#36572e"
  },
  "features": {
    "bot_user": {
      "display_name": "Wharf",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "im:write",
        "users:read",
        "mpim:history",
        "mpim:read",
        "channels:read",
        "channels:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://wharfmeetings.com/api/slack/events",
      "bot_events": [
        "app_mention",
        "message.mpim",
        "entity_details_requested"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://wharfmeetings.com/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
