{
  "name": "wharf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "mcp": "node scripts/mcp.mjs",
    "test:agents": "node --env-file=.env.production.local --import tsx scripts/verify-agents.mjs",
    "test:mcp": "node --env-file=.env.production.local scripts/verify-mcp.mjs",
    "email:verify": "node --env-file=.env.local scripts/verify-email.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
